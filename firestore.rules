rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function orgPath(org) { return /databases/$(db)/documents/orgs/$(org); }
    function memberPath(org, u) { return /databases/$(db)/documents/orgs/$(org)/members/$(u); }
    function myMember(org) { return get(memberPath(org, uid())).data; }
    function hasRole(org, roles) { return signedIn() && exists(memberPath(org, uid())) && myMember(org).role in roles; }
    function isMember(org) { return hasRole(org, ['owner', 'admin', 'manager', 'member']); }
    function isAdmin(org) { return hasRole(org, ['owner', 'admin']); }
    // Zurmelibble platform owner: approves new organisations.
    function isSuper() { return signedIn() && request.auth.uid == 'dreUCmV8iBcaauMuOVHIv4IlxqG3'; }
    // Organisations created before approval existed have no status and count as approved.
    function approved(org) { return get(orgPath(org)).data.get('status', 'approved') == 'approved'; }
    // Managers manage the team they belong to.
    function managesTeam(org, teamId) {
      return hasRole(org, ['manager']) && myMember(org).teamId != null && teamId == myMember(org).teamId;
    }

    // Personal profile and the list of organisations I belong to (for the switcher).
    match /users/{u} {
      allow read, write: if signedIn() && uid() == u;
      match /memberships/{org} {
        allow read, write: if signedIn() && uid() == u;
      }
    }

    // Invite codes: anyone signed in can look up a code they know, nobody can list them.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && getAfter(memberPath(request.resource.data.orgId, uid())).data.role in ['owner', 'admin'];
      allow update: if isSuper() || (isAdmin(resource.data.orgId) && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.get('status', 'approved') == resource.data.get('status', 'approved'));
      allow delete: if isAdmin(resource.data.orgId);
    }

    match /orgs/{org} {
      allow get: if isSuper() || hasRole(org, ['owner', 'admin', 'manager', 'member', 'pending']);
      allow list: if isSuper();
      // New organisations wait for platform approval; only the platform owner can set a brand.
      allow create: if signedIn() && request.resource.data.ownerId == uid()
        && (isSuper() || (request.resource.data.status == 'pending' && !('brand' in request.resource.data)));
      allow update: if isSuper() || (isAdmin(org)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.get('status', 'approved') == resource.data.get('status', 'approved')
        && request.resource.data.get('brand', null) == resource.data.get('brand', null));
      allow delete: if isSuper() || hasRole(org, ['owner']);

      match /members/{m} {
        allow get: if signedIn() && (uid() == m || isSuper() || isAdmin(org) || managesTeam(org, resource.data.teamId));
        allow list: if isSuper() || isAdmin(org) || managesTeam(org, resource.data.teamId);

        allow create: if signedIn() && uid() == m && request.resource.data.uid == m && (
          // Founder: the organisation is being created in the same batch.
          (request.resource.data.role == 'owner'
            && !exists(orgPath(org))
            && getAfter(orgPath(org)).data.ownerId == uid())
          ||
          // Joining with a valid invite code.
          (request.resource.data.teamId == null
            && approved(org)
            && exists(/databases/$(db)/documents/codes/$(request.resource.data.code))
            && get(/databases/$(db)/documents/codes/$(request.resource.data.code)).data.orgId == org
            && request.resource.data.role == (get(orgPath(org)).data.requireApproval == true ? 'pending' : 'member'))
        );

        allow update: if
          (isAdmin(org)
            && request.resource.data.uid == resource.data.uid
            && (resource.data.role != 'owner' || (hasRole(org, ['owner']) && request.resource.data.role == 'owner'))
            && (request.resource.data.role != 'owner' || resource.data.role == 'owner'))
          || (signedIn() && uid() == m && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));

        allow delete: if (resource.data.role != 'owner' && (isAdmin(org) || (signedIn() && uid() == m)))
          || (signedIn() && uid() == m && !existsAfter(orgPath(org)));
      }

      match /teams/{t} {
        allow read: if isMember(org);
        allow write: if isAdmin(org);
      }

      match /shifts/{s} {
        allow read: if signedIn() && (resource.data.uid == uid() || isAdmin(org) || managesTeam(org, resource.data.teamId));
        allow create: if isMember(org) && approved(org)
          && request.resource.data.uid == uid()
          && request.resource.data.teamId == myMember(org).teamId;
        allow update: if isAdmin(org) || managesTeam(org, resource.data.teamId)
          || (isMember(org) && resource.data.uid == uid()
              && request.resource.data.uid == uid()
              && request.resource.data.teamId == resource.data.teamId);
        allow delete: if isAdmin(org) || managesTeam(org, resource.data.teamId);
      }
    }
  }
}
