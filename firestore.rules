rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isAdmin() { return signedIn() && exists(me()) && get(me()).data.role == 'admin'; }

    // User profiles. Everyone starts as 'member'; only admins can change roles.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'member';
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Shifts. Members see and write their own; admins see and manage all.
    match /shifts/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
